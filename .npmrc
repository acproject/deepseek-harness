; Mirror for Electron binary downloads (https://github.com/electron/electron/releases).
; Activated when the network to github.com is slow or blocked. Remove or unset
; ELECTRON_MIRROR to restore the upstream URL.
electron_mirror=https://npmmirror.com/mirrors/electron/

; Mirror for electron-builder runtime binaries (nsis, appimage, fpm, ...).
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
