{
  "name": "@deepseek-ai/dsh-experimental-voice-conversation-bundle",
  "description": "Experimental always-on voice conversation with local SenseVoice and Kokoro; downloads runtimes on first use",
  "version": "0.2.1-alpha.3",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/voice-conversation-bundle"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-experimental-speech-to-text": "workspace:*",
    "@deepseek-ai/dsh-experimental-speech-to-text-sensevoice": "workspace:*",
    "@deepseek-ai/dsh-experimental-api-speech-to-text": "workspace:*",
    "@deepseek-ai/dsh-experimental-text-to-speech": "workspace:*",
    "@deepseek-ai/dsh-experimental-text-to-speech-kokoro": "workspace:*",
    "@deepseek-ai/dsh-experimental-api-text-to-speech": "workspace:*",
    "@deepseek-ai/dsh-experimental-client-ui-voice-conversation": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "js-yaml": "^4.3.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
